# Go worker deployment environment example.
# Copy these values into the deployment platform; do not commit real secrets.

SIGNA_DATABASE_URL=postgres://signa:signa_local@localhost:5432/signa?sslmode=disable
SIGNA_REDIS_ADDR=localhost:6379
SIGNA_WORKER_INTERVAL=500ms

SIGNA_OPENAI_API_KEY=
SIGNA_OPENAI_MODEL=gpt-4.1-mini
SIGNA_OPENAI_BASE_URL=https://api.openai.com/v1
SIGNA_AI_SCHEMA_PATH=contracts/ai/extraction/v0/schema.json
SIGNA_AI_GENERATION_SCHEMA_PATH=contracts/ai/extraction/v0/openai.schema.json
SIGNA_AI_CONSUMER_GROUP=signa-ai-text-extraction
SIGNA_AI_CONSUMER_NAME=
SIGNA_AI_POLL_INTERVAL=1s
SIGNA_AI_PROVIDER_TIMEOUT=15s
SIGNA_AI_RETRY_MAX_ATTEMPTS=3
SIGNA_AI_RETRY_BACKOFF=250ms

# Required incident policy values. Set these from the approved product policy;
# the application intentionally does not provide defaults for them.
SIGNA_INCIDENT_CANDIDATE_RADIUS_METERS=
SIGNA_INCIDENT_CANDIDATE_TIME_WINDOW=
SIGNA_INCIDENT_CANDIDATE_LIMIT=
SIGNA_INCIDENT_SIMILARITY_THRESHOLD=
SIGNA_INCIDENT_SIMILARITY_WINNER_MARGIN=

# Required confidence policy values. Thresholds must be positive and strictly increasing.
SIGNA_CONFIDENCE_EMERGING_MIN_EVIDENCE=
SIGNA_CONFIDENCE_CORROBORATED_MIN_EVIDENCE=
SIGNA_CONFIDENCE_HIGH_MIN_EVIDENCE=

# Required coordination policy value; it must be at least 1s.
SIGNA_COORDINATION_SYNC_WINDOW=

# Required lifecycle policy values. Durations must be positive and strictly increasing.
SIGNA_INCIDENT_RESOLVING_AFTER=
SIGNA_INCIDENT_RESOLVED_AFTER=
SIGNA_INCIDENT_EXPIRED_AFTER=
SIGNA_INCIDENT_LIFECYCLE_SWEEP_INTERVAL=

# Required deterministic priority policy values. P1 radius must be smaller than P2.
SIGNA_PRIORITY_P1_RADIUS_METERS=
SIGNA_PRIORITY_P2_RADIUS_METERS=
SIGNA_PRIORITY_LOCATION_MAX_AGE=
SIGNA_PRIORITY_INCIDENT_MAX_AGE=
