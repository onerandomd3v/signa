# Go API deployment environment example.
# Copy these values into the deployment platform; do not commit real secrets.

SIGNA_API_ADDR=:8080
SIGNA_DATABASE_URL=postgres://signa:signa_local@localhost:5432/signa?sslmode=disable
SIGNA_SHUTDOWN_TIMEOUT=10s

SIGNA_REPORT_RATE_PER_MINUTE=6
SIGNA_REPORT_RATE_BURST=3
SIGNA_REPORT_GLOBAL_RATE_PER_MINUTE=120
SIGNA_REPORT_GLOBAL_RATE_BURST=30

SIGNA_WEB_ALLOWED_ORIGINS=http://localhost:3000

# Optional private S3/R2-compatible media storage. Leave credentials empty until configured.
SIGNA_OBJECT_STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
SIGNA_OBJECT_STORAGE_REGION=auto
SIGNA_OBJECT_STORAGE_BUCKET=signa-local-private
SIGNA_OBJECT_STORAGE_ACCESS_KEY_ID=
SIGNA_OBJECT_STORAGE_SECRET_ACCESS_KEY=
