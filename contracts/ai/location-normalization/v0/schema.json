{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:signa:location-normalization:v0",
  "title": "Signa location normalization v0",
  "description": "Text-only location candidates derived from an extraction location reference. This contract does not geocode or add coordinates.",
  "type": "object",
  "properties": {
    "contract_version": {"const": "signa.location-normalization.v0"},
    "input_contract_version": {"const": "signa.ai.report-extraction.v0"},
    "location_state": {"enum": ["identified", "ambiguous", "unknown"]},
    "source_location_reference": {"$ref": "#/$defs/fieldState"},
    "candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"}
    }
  },
  "required": [
    "contract_version",
    "input_contract_version",
    "location_state",
    "source_location_reference",
    "candidates"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"location_state": {"const": "identified"}}, "required": ["location_state"]},
      "then": {"properties": {"candidates": {"minItems": 1, "maxItems": 1}}}
    },
    {
      "if": {"properties": {"location_state": {"const": "ambiguous"}}, "required": ["location_state"]},
      "then": {"properties": {"candidates": {"minItems": 2}}}
    },
    {
      "if": {"properties": {"location_state": {"const": "unknown"}}, "required": ["location_state"]},
      "then": {"properties": {"candidates": {"maxItems": 0}}}
    }
  ],
  "$defs": {
    "fieldState": {
      "type": "object",
      "properties": {
        "status": {"enum": ["identified", "ambiguous", "unknown"]},
        "value": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "candidates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "evidence_quotes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "required": ["status", "value", "candidates", "evidence_quotes"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "identified"}}, "required": ["status"]},
          "then": {"properties": {"value": {"type": "string", "minLength": 1}, "candidates": {"maxItems": 0}, "evidence_quotes": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"status": {"const": "ambiguous"}}, "required": ["status"]},
          "then": {"properties": {"value": {"type": "null"}, "candidates": {"minItems": 2}, "evidence_quotes": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"status": {"const": "unknown"}}, "required": ["status"]},
          "then": {"properties": {"value": {"type": "null"}, "candidates": {"maxItems": 0}, "evidence_quotes": {"maxItems": 0}}}
        }
      ]
    },
    "candidate": {
      "type": "object",
      "properties": {
        "reported_text": {"type": "string", "minLength": 1},
        "normalized_text": {"type": "string", "minLength": 1},
        "reference_kind": {"enum": ["named_place", "area", "neighborhood", "landmark", "road", "junction", "market", "unknown"]},
        "qualifier": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "evidence_quotes": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}
      },
      "required": ["reported_text", "normalized_text", "reference_kind", "qualifier", "evidence_quotes"],
      "additionalProperties": false
    }
  }
}
