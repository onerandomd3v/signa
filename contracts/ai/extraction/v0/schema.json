{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:signa:ai-report-extraction:v0",
  "title": "Signa AI report extraction v0",
  "description": "Interpretive extraction from one raw report. This output is not verification or deterministic incident policy.",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "signa.ai.report-extraction.v0"
    },
    "taxonomy_version": {
      "const": "signa.event-taxonomy.v0"
    },
    "event_type": {
      "$ref": "#/$defs/eventTypeField"
    },
    "location_reference": {
      "$ref": "#/$defs/textField"
    },
    "time_reference": {
      "$ref": "#/$defs/textField"
    },
    "source_claim": {
      "$ref": "#/$defs/sourceClaimField"
    },
    "language": {
      "$ref": "#/$defs/languageField"
    },
    "severity_candidate": {
      "$ref": "#/$defs/severityField"
    }
  },
  "required": [
    "contract_version",
    "taxonomy_version",
    "event_type",
    "location_reference",
    "time_reference",
    "source_claim",
    "language",
    "severity_candidate"
  ],
  "additionalProperties": false,
  "$defs": {
    "fieldState": {
      "type": "object",
      "properties": {
        "status": {
          "enum": ["identified", "ambiguous", "unknown"]
        },
        "value": {
          "anyOf": [
            {"type": "string"},
            {"type": "null"}
          ]
        },
        "candidates": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "evidence_quotes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "required": ["status", "value", "candidates", "evidence_quotes"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "identified"}}, "required": ["status"]},
          "then": {
            "properties": {
              "value": {"type": "string", "minLength": 1},
              "candidates": {"maxItems": 0},
              "evidence_quotes": {"minItems": 1}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "ambiguous"}}, "required": ["status"]},
          "then": {
            "properties": {
              "value": {"type": "null"},
              "candidates": {"minItems": 2},
              "evidence_quotes": {"minItems": 1}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "unknown"}}, "required": ["status"]},
          "then": {
            "properties": {
              "value": {"type": "null"},
              "candidates": {"maxItems": 0},
              "evidence_quotes": {"maxItems": 0}
            }
          }
        }
      ]
    },
    "eventTypeField": {
      "$ref": "#/$defs/fieldState",
      "properties": {
        "value": {
          "anyOf": [
            {"enum": ["possible_gunfire", "road_closure", "traffic_collision", "fire", "flooding", "other"]},
            {"type": "null"}
          ]
        },
        "candidates": {
          "type": "array",
          "items": {"enum": ["possible_gunfire", "road_closure", "traffic_collision", "fire", "flooding", "other"]},
          "uniqueItems": true
        }
      }
    },
    "textField": {
      "$ref": "#/$defs/fieldState"
    },
    "sourceClaimField": {
      "$ref": "#/$defs/fieldState",
      "properties": {
        "value": {
          "anyOf": [
            {"enum": ["first_hand", "second_hand", "forwarded", "unclear"]},
            {"type": "null"}
          ]
        },
        "candidates": {
          "type": "array",
          "items": {"enum": ["first_hand", "second_hand", "forwarded", "unclear"]},
          "uniqueItems": true
        }
      }
    },
    "languageField": {
      "$ref": "#/$defs/fieldState",
      "properties": {
        "value": {
          "anyOf": [
            {"enum": ["en", "pcm", "en-pcm"]},
            {"type": "null"}
          ]
        },
        "candidates": {
          "type": "array",
          "items": {"enum": ["en", "pcm", "en-pcm"]},
          "uniqueItems": true
        }
      }
    },
    "severityField": {
      "$ref": "#/$defs/fieldState",
      "properties": {
        "value": {
          "anyOf": [
            {"enum": ["LOW", "MODERATE", "HIGH", "CRITICAL"]},
            {"type": "null"}
          ]
        },
        "candidates": {
          "type": "array",
          "items": {"enum": ["LOW", "MODERATE", "HIGH", "CRITICAL"]},
          "uniqueItems": true
        }
      }
    }
  }
}
