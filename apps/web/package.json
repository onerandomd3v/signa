{
  "name": "@signa/web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write . ../../README.md",
    "format:check": "prettier --check . ../../README.md",
    "api:lint": "redocly lint ../../contracts/openapi.yaml",
    "api:generate": "openapi-ts",
    "api:check": "npm run api:lint && npm run api:generate && git diff --exit-code -- lib/api/generated",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@redocly/cli": "2.53.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
