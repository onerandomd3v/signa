# Public Go API URL. This value is exposed in browser bundles; never put secrets here.
# Defaults to http://localhost:8080 in development.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Optional public MapLibre style URL. The style and tile service are public,
# may have provider terms/rate limits, and must not contain credentials.
NEXT_PUBLIC_MAP_STYLE_URL=

# Public VAPID key for browser-side Web Push subscription. Never put a private key here.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
